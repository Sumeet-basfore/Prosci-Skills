{
  "name": "prosci-verify",
  "triggers": [
    "prove it works",
    "end to end",
    "exercise the real surface",
    "smoke check a release"
  ],
  "non_triggers": [
    "judge completion \u2192 prosci-bar",
    "review code \u2192 prosci-review",
    "fix what you find \u2192 prosci-fix"
  ],
  "references": [
    {
      "path": "references/cli.md",
      "load_when": "verifying a command-line surface"
    },
    {
      "path": "references/http.md",
      "load_when": "verifying an HTTP API"
    },
    {
      "path": "references/browser.md",
      "load_when": "verifying a rendered browser surface"
    }
  ],
  "note": "references are optional depth; essential rules are in SKILL.md and must not depend on a read"
}
