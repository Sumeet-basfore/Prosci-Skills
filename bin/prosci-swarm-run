#!/usr/bin/env node
// Bounded execution controller for validated swarm plans.
//
//   bin/prosci-swarm-run <plan.json> --approve <plan-hash> [--backend fake] [--out <dir>]
//                                   [--concurrency N] [--deadline-min N] [--resume]
//
// What it does: validates the plan, enforces dependencies and concurrency, runs each unit in an isolated
// git worktree, rejects changes outside the unit's owned files, records every lifecycle transition, and
// stops on failure. It does not publish, force-push, or resolve semantic conflicts.
//
// What it does NOT do: spawn real agents unless --backend pi --allow-paid is passed, in which case a single
// provider/model path is used. Neither backend is a sandbox: a worktree isolates files, not credentials.
//
// Approval: --approve must equal `bin/prosci-swarm hash <plan>`. A different plan needs a new approval.

import { readFileSync, writeFileSync, mkdirSync, existsSync, rmSync } from "node:fs";
import { join, resolve, dirname } from "node:path";
import { fileURLToPath } from "node:url";
import { spawnSync } from "node:child_process";
import { createHash } from "node:crypto";
import { loadRegistries, validatePlan, handoffText } from "./lib/swarm.mjs";
import { spawnGroup, killGroup, groupAlive } from "./lib/proc.mjs";
import { openBudget, usage } from "./lib/request-budget.mjs";
import { createRecord, loadRecord, saveRecord, claimExecution, effectiveRetries } from "./lib/exec-auth.mjs";

const args = process.argv.slice(2);
const planPath = args.find((a) => !a.startsWith("--"));
const flag = (name, fallback) => {
  const i = args.indexOf(name);
  return i > -1 ? args[i + 1] : fallback;
};
const has = (name) => args.includes(name);

if (!planPath) {
  console.error("usage: prosci-swarm-run <plan.json> --approve <hash> [--backend fake|pi] [--out dir]");
  process.exit(2);
}

const plan = JSON.parse(readFileSync(planPath, "utf8"));
const registries = loadRegistries();
const profileName = flag("--profile", plan.profile ?? "balanced");
const validation = validatePlan(plan, profileName, registries);
if (!validation.valid) {
  for (const e of validation.errors) console.error(`FAIL ${e}`);
  process.exit(1);
}

// Approval is enforced here, not in prose: no matching hash, no execution.
const planHash = createHash("sha256").update(readFileSync(planPath)).digest("hex").slice(0, 16);
const approval = flag("--approve", null);
if (!approval) {
  console.error(`approval required: review the plan, then pass --approve ${planHash}`);
  process.exit(2);
}
if (approval !== planHash) {
  console.error(`approval does not match this plan (expected ${planHash}); a changed plan needs a new approval`);
  process.exit(2);
}

const backend = flag("--backend", "fake");
if (backend === "pi" && !has("--allow-paid")) {
  console.error("the pi backend spends money; pass --allow-paid to acknowledge the budget in the plan");
  process.exit(2);
}
if (!["fake", "pi"].includes(backend)) {
  console.error(`unsupported backend: ${backend}`);
  process.exit(2);
}

// Authorization: an explicit file that caps executions, retries and requests. The plan hash alone is not an
// approval — it is reusable, which is how three executions happened under one authorization.
const authPath = flag("--authorization", null);
let auth = null;
if (authPath) {
  auth = loadRecord(authPath, planHash) ?? createRecord({
    planHash,
    maxExecutions: Number(flag("--max-executions", 1)),
    maxRetriesPerUnit: Number(flag("--max-retries", 1)),
    maxRequests: Number(flag("--max-requests", 100)),
  });
  const claimed = claimExecution(auth, { planHash });
  if (!claimed.ok) {
    console.error(`execution refused: ${claimed.reason}`);
    process.exit(2);
  }
  saveRecord(authPath, auth);
} else if (backend === "pi") {
  console.error("a paid backend requires --authorization <file>; the plan hash alone is not a spend approval");
  process.exit(2);
}

const outDir = resolve(flag("--out", "swarm-run"));
mkdirSync(join(outDir, "handoffs"), { recursive: true });
mkdirSync(join(outDir, "worktrees"), { recursive: true });
mkdirSync(join(outDir, "output"), { recursive: true });
const ledgerPath = join(outDir, "ledger.json");

const maxConcurrency = Number(flag("--concurrency", plan.maxConcurrency ?? validation.profile.limits?.concurrency ?? 1));
const limitConcurrency = validation.profile.limits?.concurrency;
if (limitConcurrency && maxConcurrency > limitConcurrency) {
  console.error(`concurrency ${maxConcurrency} exceeds the profile limit ${limitConcurrency}`);
  process.exit(2);
}
const deadlineMs = Number(flag("--deadline-min", 0)) * 60000;
const unitDeadlineMs = Number(flag("--unit-deadline-min", 20)) * 60000;

// P2: the proxy's own budget file is the atomic gate. It is opened to whatever is left of the execution's
// request allowance, so concurrent workers cannot collectively exceed it.
const budgetPath = join(outDir, "request-budget.json");
const accessLines = () => {
  try { return readFileSync(join(outDir, "proxy-access.jsonl"), "utf8").trim().split("\n").filter(Boolean).length; } catch { return 0; }
};
let budgetSnapshot = null;
const requestAllowance = auth ? auth.maxRequests - auth.requestsUsed : Number.POSITIVE_INFINITY;
if (Number.isFinite(requestAllowance)) openBudget(budgetPath, Math.max(0, requestAllowance));
if (auth) process.env.PROXY_BUDGET_FILE = budgetPath;
const accessLogPath = join(outDir, "proxy-access.jsonl");
process.env.PROXY_ACCESS_LOG = accessLogPath;

// Sequence windows say what happened in what order; these say when. Wall time can jump, so duration
// comes from the monotonic clock and both are recorded instead of one standing in for the other.
const now = () => ({ wall: Date.now(), mono: Number(process.hrtime.bigint() / 1000000n) });

const units = plan.units.map((u) => ({ ...u, status: "planned", attempts: 0, transitions: [], worktree: null, branch: null, evidence: [], startedAt: null, finishedAt: null, startedAtEpoch: null, finishedAtEpoch: null, startedAtMono: null, finishedAtMono: null }));
const byId = new Map(units.map((u) => [u.id, u]));
const previous = existsSync(ledgerPath) && has("--resume") ? JSON.parse(readFileSync(ledgerPath, "utf8")) : null;

let step = 0;
const transition = (unit, to, detail = "") => {
  step += 1;
  unit.status = to;
  const when = now();
  if (to === "running") Object.assign(unit, { startedAt: step, startedAtEpoch: when.wall, startedAtMono: when.mono });
  if (["succeeded", "failed", "blocked", "cancelled"].includes(to)) Object.assign(unit, { finishedAt: step, finishedAtEpoch: when.wall, finishedAtMono: when.mono });
  unit.transitions.push({ at: `step-${unit.transitions.length + 1}`, seq: step, to, detail, wall: when.wall, mono: when.mono });
  persist();
};

function persist() {
  writeFileSync(ledgerPath, JSON.stringify({
    schema: 1,
    plan: plan.id ?? null,
    planHash,
    profile: profileName,
    backend,
    approved: true,
    authorization: auth ? { maxExecutions: auth.maxExecutions, executions: auth.executions, maxRetriesPerUnit: auth.maxRetriesPerUnit, requestsUsed: auth.requestsUsed, maxRequests: auth.maxRequests } : null,
    requests: budgetSnapshot ? { reserved: budgetSnapshot.used, limit: budgetSnapshot.limit, logged: accessLines() } : null,
    enforcement: {
      approval: "enforced by this controller (plan hash)",
      concurrency: "enforced by this controller",
      dependencies: "enforced by this controller",
      ownership: "checked from git after each unit",
      deadline: deadlineMs ? "enforced by killing the process tree" : "not set",
      tokens: "reported, not enforced",
      estimatedCostUsd: "advisory",
    },
    limits: { maxConcurrency, deadlineMs, profile: validation.profile.limits },
    budget: validation.budget,
    units: units.map((u) => ({
      id: u.id, role: u.role, model: u.model, status: u.status, attempts: u.attempts,
      startedAt: u.startedAt, finishedAt: u.finishedAt,
      startedAtEpoch: u.startedAtEpoch, finishedAtEpoch: u.finishedAtEpoch,
      startedAtMono: u.startedAtMono, finishedAtMono: u.finishedAtMono,
      branch: u.branch, worktree: u.worktree, evidence: u.evidence, transitions: u.transitions,
      planRetries: u.budget?.retries ?? 0, retriesClamped: u.retriesClamped ?? null,
      checksRun: u.checksRun ?? [], changedFiles: u.changedFiles ?? [], predecessorCommits: u.predecessorCommits ?? [],
      tokens: u.tokens ?? null, costUsd: u.costUsd ?? null,
    })),
  }, null, 2));
}

// Resume: succeeded units stay done; anything that was running is treated as interrupted and retried.
if (previous) {
  for (const prior of previous.units ?? []) {
    const unit = byId.get(prior.id);
    if (!unit) continue;
    if (prior.status === "succeeded") {
      unit.status = "succeeded";
      unit.branch = prior.branch;
      unit.evidence = prior.evidence ?? [];
      unit.transitions = prior.transitions ?? [];
    } else {
      // A unit that was interrupted is rebuilt from scratch: a stale worktree may predate its predecessors'
      // commits, and reusing it would hand the worker the wrong base.
      if (prior.worktree && existsSync(prior.worktree)) spawnSync("git", ["worktree", "remove", "--force", prior.worktree], { encoding: "utf8" });
      if (prior.branch) spawnSync("git", ["branch", "-D", prior.branch], { encoding: "utf8" });
      unit.transitions = prior.transitions ?? [];
      unit.transitions.push({ at: `resume`, to: "planned", detail: `recovered from ${prior.status}; worktree rebuilt` });
    }
  }
}

const base = spawnSync("git", ["rev-parse", "HEAD"], { cwd: process.cwd(), encoding: "utf8" }).stdout.trim();

function changedFilesIn(worktree, since) {
  const status = spawnSync("git", ["status", "--porcelain=v1", "--untracked-files=all"], { cwd: worktree, encoding: "utf8" }).stdout;
  const tracked = spawnSync("git", ["diff", "--name-only", since], { cwd: worktree, encoding: "utf8" }).stdout;
  return [...new Set([...status.split("\n").filter(Boolean).map((l) => l.slice(3).trim()), ...tracked.split("\n").filter(Boolean)])];
}

// Prepare a unit: dependency integration, worktree, handoff. Git work is serialised because it mutates the
// repository; only the worker runs concurrently.
function prepareUnit(unit) {
  const missing = (unit.dependsOn ?? []).filter((d) => byId.get(d)?.status !== "succeeded");
  if (missing.length) {
    transition(unit, "blocked", `waiting on ${missing.join(", ")}`);
    return null;
  }
  transition(unit, "ready");
  const worktree = join(outDir, "worktrees", unit.id);
  const branch = `prosci/${plan.id ?? "run"}/${planHash.slice(0, 6)}/${unit.id}`;
  let startPoint = base;
  const depBranches = (unit.dependsOn ?? []).map((d) => byId.get(d)?.branch).filter(Boolean);
  if (depBranches.length) {
    const integration = `prosci/${plan.id ?? "run"}/${planHash.slice(0, 6)}/integration/${unit.id}`;
    // Check the integration branch out: `git branch -f` moves a ref but merges land on HEAD, which is
    // how a predecessor's commits silently failed to reach its dependents.
    spawnSync("git", ["checkout", "-q", "-B", integration, base], { encoding: "utf8" });
    const checkout = spawnSync("git", ["rev-parse", "--abbrev-ref", "HEAD"], { encoding: "utf8" }).stdout.trim();
    for (const depBranch of depBranches) {
      const merge = spawnSync("git", ["-c", "user.name=prosci", "-c", "user.email=prosci@local", "merge", "--no-ff", "-q", "-m", `integrate ${depBranch}`, depBranch], { encoding: "utf8" });
      if (merge.status !== 0) {
        spawnSync("git", ["merge", "--abort"], { encoding: "utf8" });
        transition(unit, "blocked", `predecessor merge conflict: ${merge.stderr.slice(0, 160)}`);
        return null;
      }
    }
    spawnSync("git", ["checkout", "-q", checkout], { encoding: "utf8" });
    startPoint = spawnSync("git", ["rev-parse", integration], { encoding: "utf8" }).stdout.trim();
    unit.predecessorCommits = depBranches.map((b) => ({ branch: b, sha: spawnSync("git", ["rev-parse", b], { encoding: "utf8" }).stdout.trim() }));
  }
  if (!existsSync(worktree)) {
    const added = spawnSync("git", ["worktree", "add", "-q", "-b", branch, worktree, startPoint], { encoding: "utf8" });
    if (added.status !== 0) { transition(unit, "failed", `worktree: ${added.stderr.slice(0, 200)}`); return null; }
  }
  unit.worktree = worktree;
  unit.branch = branch;
  unit.startPoint = startPoint;
  const handoff = handoffText(unit, profileName, registries.roles);
  writeFileSync(join(outDir, "handoffs", `${unit.id}.md`), handoff);
  return { worktree, handoff, startPoint };
}

function resolveSkills(names) {
  const skillsRoot = process.env.PI_CODING_AGENT_DIR ? join(process.env.PI_CODING_AGENT_DIR, "skills") : null;
  return (names ?? []).flatMap((name) => {
    if (skillsRoot && existsSync(join(skillsRoot, name))) return ["--skill", join(skillsRoot, name)];
    if (existsSync(name)) return ["--skill", name];
    return ["--skill", name];
  });
}

function modelProvider(modelId) {
  return modelId.includes("/") ? modelId.split("/")[0] : "prosci-proxy";
}

// One attempt: a child process in the unit's worktree, in its own process group. Concurrency is real, and so
// is the kill: a deadline or a cancellation signals the group, not just the child.
async function attemptUnit(unit, { worktree, handoff }, attempt, deadlineMs, onSpawn = () => {}) {
  unit.attempts = attempt;
  transition(unit, "running", `attempt ${attempt}`);

  // P2: reservations happen at the proxy, immediately before forwarding. The controller only refuses to
  // start a unit when the allowance is already spent, so attempts and requests stay separate quantities.
  if (Number.isFinite(requestAllowance)) {
    const state = usage(budgetPath);
    if (state.used >= state.limit) {
      transition(unit, "failed", `request budget exhausted (${state.used}/${state.limit})`);
      return false;
    }
  }

  const start = now();
  const spec = unit.fake ?? { outcome: "success" };
  const spawned = backend === "fake"
    ? spawnGroup(process.execPath, [join(dirname(fileURLToPath(import.meta.url)), "lib", "fake-worker.mjs"), JSON.stringify(spec)], { cwd: worktree, env: process.env })
    : spawnGroup("pi", ["-p", "--mode", "json", "--model", unit.model, ...resolveSkills(unit.skills), `${handoff}\n\nDo only this unit. Run the acceptance checks and report what you ran.\n`], { cwd: worktree, env: process.env });

  // Recorded before the worker finishes, so a cancellation can still find and kill the group.
  const evidence = { attempt, ok: false, kind: "running", pgid: spawned.pgid, ms: null, startedAtEpoch: start.wall, startedAtMono: start.mono, finishedAtEpoch: null, finishedAtMono: null };
  unit.evidence.push(evidence);
  onSpawn(spawned.kill);

  let timedOut = false;
  const timer = setTimeout(() => { timedOut = true; spawned.kill(); }, deadlineMs || 20 * 60 * 1000);
  const result = await spawned.done;
  // The raw stream is what proves which skills a worker actually opened; tool names alone do not.
  writeFileSync(join(outDir, "output", `${unit.id}-a${attempt}.stdout.jsonl`), result.stdout ?? "");
  writeFileSync(join(outDir, "output", `${unit.id}-a${attempt}.stderr.txt`), result.stderr ?? "");
  clearTimeout(timer);
  const end = now();
  const ms = end.mono - start.mono;

  Object.assign(evidence, { ms, wallMs: end.wall - start.wall, finishedAtEpoch: end.wall, finishedAtMono: end.mono, groupKilled: timedOut });
  if (timedOut) { Object.assign(evidence, { kind: "timeout", detail: `${ms}ms` }); return "timeout"; }
  if (result.error) { Object.assign(evidence, { kind: "crash", detail: String(result.error.message ?? result.error) }); return "crash"; }

  if (backend === "fake") {
    if (spec.outcome === "crash" || result.code !== 0) { Object.assign(evidence, { kind: "crash", detail: `exit ${result.code}` }); return "crash"; }
    if (spec.outcome === "invalid") { Object.assign(evidence, { kind: "invalid", detail: "result is not JSON" }); return "invalid"; }
  } else {
    let events;
    try {
      events = result.stdout.split("\n").filter((l) => l.trim()).map((l) => JSON.parse(l));
    } catch {
      Object.assign(evidence, { kind: "invalid", detail: "pi did not emit JSON lines" });
      return "invalid";
    }
    const assistant = events.filter((e) => e.type === "message_end" && e.message?.role === "assistant");
    const reported = assistant.map((e) => `${e.message.provider ?? "?"}/${e.message.model ?? "?"}`).filter((v, i, a) => a.indexOf(v) === i);
    const tools = assistant.flatMap((e) => (e.message.content ?? []).filter((c) => c.type === "toolCall").map((c) => c.name));
    const usage = assistant.at(-1)?.message?.usage ?? null;
    Object.assign(evidence, { ok: true, kind: "success", detail: `${ms}ms`, reportedModel: reported, toolCalls: tools, usage });
    if (reported.length && reported.some((r) => !r.endsWith(unit.model.replace(/^.*\//, "")))) {
      transition(unit, "failed", `model mismatch: reported ${reported.join(", ")}`);
      return "mismatch";
    }
  }

  // Ownership is checked from git, after the fact. It detects an out-of-bounds write; it does not prevent one.
  const changed = changedFilesIn(worktree, unit.startPoint);
  const owned = new Set(unit.files);
  const outside = changed.filter((f) => !owned.has(f) && !f.startsWith(".prosci") && !f.startsWith("request-budget"));
  if (outside.length) {
    Object.assign(evidence, { kind: "ownership", detail: outside.join(", ") });
    transition(unit, "failed", `changed files outside ownership: ${outside.join(", ")}`);
    return "ownership";
  }
  unit.changedFiles = changed;

  const checks = (unit.checks ?? []).map((check) => {
    const r = spawnSync("sh", ["-c", check], { cwd: worktree, encoding: "utf8", timeout: 120000 });
    return { check, ok: r.status === 0, detail: (r.stderr || r.stdout || "").slice(0, 200) };
  });
  unit.checksRun = checks;
  const failed = checks.filter((c) => !c.ok);
  if (failed.length) {
    Object.assign(evidence, { kind: "acceptance", detail: failed.map((c) => c.check).join("; ") });
    return "acceptance";
  }
  spawnSync("sh", ["-c", `git add -A && git -c user.name=prosci -c user.email=prosci@local commit -qm "unit ${unit.id}: ${unit.goal.replace(/"/g, "'").slice(0, 60)}"`], { cwd: worktree });
  return "success";
}

// Bounded concurrency: independent units run at the same time; dependent units wait for a succeeded
// predecessor. Their intervals overlap in the ledger, which is what makes the claim checkable.
persist();

const inFlight = new Map();
let cancelled = false;
const startedAt = Date.now();

const cancelAll = (reason) => {
  cancelled = true;
  for (const [id, handle] of inFlight) {
    handle.kill();
    const unit = byId.get(id);
    if (unit && !["succeeded", "failed"].includes(unit.status)) transition(unit, "cancelled", reason);
  }
  for (const u of units) if (["planned", "ready"].includes(u.status)) transition(u, "cancelled", reason);
  persist();
};
process.on("SIGINT", () => { cancelAll("interrupted by operator"); process.exit(130); });
process.on("SIGTERM", () => { cancelAll("terminated"); process.exit(143); });

const runOne = async (unit, prepared, retries, onSpawn) => {
  let outcome = await attemptUnit(unit, prepared, 1, unitDeadlineMs, onSpawn);
  let attempt = 1;
  while (["acceptance", "crash", "invalid"].includes(outcome) && attempt <= retries) {
    attempt += 1;
    transition(unit, "ready", `${outcome}, retrying`);
    outcome = await attemptUnit(unit, prepared, attempt, unitDeadlineMs, onSpawn);
  }
  if (outcome === "success") transition(unit, "succeeded", `checks passed (${(unit.checksRun ?? []).length})`);
  else if (!["failed", "blocked", "cancelled"].includes(unit.status)) {
    const detail = { acceptance: "acceptance failed", timeout: "unit deadline exceeded", crash: "worker crashed", invalid: "invalid worker output", ownership: "wrote outside ownership", mismatch: "model mismatch" }[outcome] ?? outcome;
    transition(unit, "failed", detail);
  }
};

while (!cancelled) {
  if (deadlineMs && Date.now() - startedAt > deadlineMs) { cancelAll("global deadline exceeded"); break; }

  while (inFlight.size < maxConcurrency) {
    const next = units.find((u) => u.status === "planned" && (u.dependsOn ?? []).every((d) => byId.get(d)?.status === "succeeded"));
    if (!next) break;
    const prepared = prepareUnit(next);
    if (!prepared) continue;
    const planRetries = next.budget?.retries ?? 0;
    const retries = auth ? effectiveRetries(auth, planRetries) : planRetries;
    if (auth && retries !== planRetries) next.retriesClamped = { plan: planRetries, authorized: retries };
    const handle = { kill: () => {}, promise: null };
    handle.promise = runOne(next, prepared, retries, (kill) => { handle.kill = kill; }).finally(() => inFlight.delete(next.id));
    inFlight.set(next.id, handle);
  }

  if (!inFlight.size) {
    for (const u of units) {
      if (u.status !== "planned") continue;
      const bad = (u.dependsOn ?? []).filter((d) => ["failed", "blocked", "cancelled"].includes(byId.get(d)?.status));
      if (bad.length) transition(u, "blocked", `dependency ${bad.join(", ")} did not succeed`);
    }
    break;
  }
  // Wait for any unit to finish, or poll again when the limit frees a slot.
  await Promise.race([...inFlight.values()].map((h) => h.promise));
}

persist();

// P2: reconcile the proxy's own accounting with the ledger. The reservation count is authoritative; the
// authorization record is charged with what the run actually consumed.
const budget = Number.isFinite(requestAllowance) ? usage(budgetPath) : null;
budgetSnapshot = budget;
if (auth && budget) {
  auth.requestsUsed += budget.used;
  saveRecord(authPath, auth);
}
persist();

const summary = {
  planned: units.filter((u) => u.status === "planned").length,
  succeeded: units.filter((u) => u.status === "succeeded").length,
  failed: units.filter((u) => u.status === "failed").length,
  blocked: units.filter((u) => u.status === "blocked").length,
  cancelled: units.filter((u) => u.status === "cancelled").length,
};
console.log(`run complete: ${summary.succeeded} succeeded, ${summary.failed} failed, ${summary.blocked} blocked, ${summary.cancelled} cancelled`);
if (budget) console.log(`requests: ${budget.used}/${budget.limit} consumed (reserved at the proxy)`);
console.log(`ledger: ${ledgerPath}`);
for (const u of units) if (u.status !== "succeeded") console.error(`  ${u.id}: ${u.status} — ${u.transitions.at(-1)?.detail ?? ""}`);
process.exit(summary.failed || summary.blocked || summary.cancelled ? 1 : 0);
