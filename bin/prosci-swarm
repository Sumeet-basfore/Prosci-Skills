#!/usr/bin/env node
// Deterministic plan validator and allocator for multi-agent work.
//
//   bin/prosci-swarm check <plan.json> [--profile balanced] [--json]
//   bin/prosci-swarm emit  <plan.json> [--profile balanced] [--out <dir>] [--json]
//
// Exit codes: 0 valid, 1 invalid plan, 2 bad usage or unreadable registry.

import { readFileSync, writeFileSync, mkdirSync } from "node:fs";
import { join } from "node:path";
import { loadRegistries, validatePlan, handoffText } from "./lib/swarm.mjs";

const args = process.argv.slice(2);
const command = args[0];
const planPath = args[1];
const flag = (name, fallback) => {
  const i = args.indexOf(name);
  return i > -1 ? args[i + 1] : fallback;
};

if (!["check", "emit", "hash"].includes(command) || !planPath) {
  console.error("usage: prosci-swarm (check|emit|hash) <plan.json> [--profile balanced] [--out <dir>] [--json]");
  process.exit(2);
}

const plan = JSON.parse(readFileSync(planPath, "utf8"));
const registries = loadRegistries();
const profileName = flag("--profile", plan.profile ?? "balanced");

// The approval token: a stable digest of the validated plan, so "approved" cannot be reused for a
// different plan. Not a signature; it binds the approval to the text the human was shown.
if (command === "hash") {
  const { createHash } = await import("node:crypto");
  console.log(createHash("sha256").update(readFileSync(planPath)).digest("hex").slice(0, 16));
  process.exit(0);
}

const result = validatePlan(plan, profileName, registries);

if (command === "check") {
  if (args.includes("--json")) console.log(JSON.stringify({ ...result, units: plan.units?.length ?? 0, budget: result.budget }, null, 2));
  else {
    for (const e of result.errors) console.error(`FAIL ${e}`);
    for (const w of result.warnings) console.error(`WARN ${w}`);
    if (result.valid) console.log(`plan valid: ${plan.units.length} units, profile ${profileName}, ${result.budget.unitTokens} tokens, ~$${result.budget.unitEstimatedCostUsd}`);
  }
  process.exit(result.valid ? 0 : 1);
}

if (!result.valid) {
  for (const e of result.errors) console.error(`FAIL ${e}`);
  console.error("refusing to emit a handoff set for an invalid plan");
  process.exit(1);
}
const outDir = flag("--out", "swarm");
mkdirSync(join(outDir, "handoffs"), { recursive: true });
writeFileSync(join(outDir, "swarm-plan.json"), JSON.stringify({ ...plan, validatedAt: "deterministic:no-timestamp" }, null, 2));
for (const unit of plan.units) writeFileSync(join(outDir, "handoffs", `${unit.id}.md`), handoffText(unit, profileName, registries.roles));
writeFileSync(join(outDir, "ledger.json"), JSON.stringify({
  schema: 1,
  plan: plan.id ?? null,
  profile: profileName,
  units: plan.units.map((u) => ({ id: u.id, role: u.role, model: u.model, status: "planned", tokens: null, costUsd: null })),
  enforcement: registries.budgets.enforcement,
}, null, 2));
console.log(`emitted ${plan.units.length} handoffs, ledger and validated plan into ${outDir}`);
