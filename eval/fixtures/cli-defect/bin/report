#!/usr/bin/env node
import { readFileSync } from "node:fs";
import { total } from "../src/total.mjs";

const args = process.argv.slice(2);
const file = args[args.indexOf("--total") + 1];
if (!file) {
  console.error("usage: bin/report --total <file>");
  process.exit(2);
}
const rows = readFileSync(file, "utf8").trim().split("\n").filter(Boolean).map((line) => ({ cents: Number(line) }));
console.log(total(rows));
